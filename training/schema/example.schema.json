{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://precision3dprints.com.au/localpilot/training/example.schema.json",
  "title": "LocalPilot training/evaluation example",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "messages",
    "task_type",
    "source",
    "license",
    "quality_tier",
    "split",
    "verification_status",
    "provenance"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
    },
    "messages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "content"],
        "properties": {
          "role": {"enum": ["system", "user", "assistant", "tool"]},
          "content": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1}
        }
      },
      "contains": {
        "type": "object",
        "properties": {"role": {"const": "user"}},
        "required": ["role"]
      },
      "minContains": 1
    },
    "task_type": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_:-]{1,79}$"
    },
    "source": {"type": "string", "minLength": 1},
    "license": {"type": "string", "minLength": 1},
    "quality_tier": {"enum": ["A", "B", "C", "D"]},
    "split": {"enum": ["train", "validation", "held_out_eval"]},
    "verification_status": {
      "enum": [
        "human_verified",
        "ci_verified",
        "source_verified",
        "synthetic_validated",
        "review_required",
        "unverified"
      ]
    },
    "provenance": {
      "type": "object",
      "minProperties": 1,
      "required": ["reference"],
      "properties": {
        "reference": {"type": "string", "minLength": 1},
        "repository": {"type": "string", "minLength": 1},
        "url": {"type": "string", "minLength": 1},
        "notes": {"type": "string"},
        "license_reference": {"type": "string"}
      },
      "additionalProperties": true
    },
    "tags": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "difficulty": {"enum": ["easy", "medium", "hard", "expert"]},
    "expected_behavior": {
      "oneOf": [
        {"type": "string", "minLength": 1},
        {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      ]
    },
    "created_at": {"type": "string", "format": "date-time"},
    "metadata": {"type": "object"}
  },
  "allOf": [
    {
      "if": {
        "properties": {"split": {"enum": ["train", "validation"]}},
        "required": ["split"]
      },
      "then": {
        "properties": {
          "quality_tier": {"enum": ["A", "B", "C"]},
          "verification_status": {
            "enum": ["human_verified", "ci_verified", "source_verified", "synthetic_validated"]
          },
          "messages": {
            "contains": {
              "type": "object",
              "properties": {"role": {"const": "assistant"}},
              "required": ["role"]
            },
            "minContains": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {"split": {"const": "held_out_eval"}},
        "required": ["split"]
      },
      "then": {
        "required": ["expected_behavior"],
        "properties": {
          "quality_tier": {"enum": ["A", "B"]},
          "verification_status": {"enum": ["human_verified", "ci_verified", "source_verified"]}
        },
        "not": {
          "properties": {
            "messages": {
              "contains": {
                "type": "object",
                "properties": {"role": {"const": "assistant"}},
                "required": ["role"]
              }
            }
          }
        }
      }
    }
  ]
}
